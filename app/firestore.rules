rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }

    // 句会：ログインした人なら、だれでも読める・出せる・点をつけられる。消すのは不可
    // 句（entries）は、消えないように守る：書きかえのあとも、まえにあった人の句がぜんぶ残っていること（自分の句の取り下げだけは可）
    function keepsEntries() {
      return !('entries' in resource.data)
        || ('entries' in request.resource.data
            && request.resource.data.entries.keys().hasAll(resource.data.entries.keys().removeAll([request.auth.uid])));
    }
    match /kukai/{sid} {
      allow read, create: if signedIn();
      allow update: if signedIn() && keepsEntries();
      allow delete: if false;
    }
    // ミニ合評ルーム：句会と同じ
    match /gohyo/{rid} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
    // 定例句会の参加人数だけの、公開の小さな記録（Xのお礼つぶやき用）。
    // だれでも読める。ログインした人が、1回だけ作れる（あとから書きかえ・消去は不可）。句や名前は入らない
    match /pub/{sid} {
      allow read: if true;
      allow create: if signedIn()
        && sid.matches('t[0-9]{8}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['humans', 'bots', 'slot', 'date', 'at'])
        && request.resource.data.humans is int && request.resource.data.humans >= 1 && request.resource.data.humans <= 500
        && request.resource.data.bots is int && request.resource.data.bots >= 0 && request.resource.data.bots <= 5;
      allow update, delete: if false;
    }
    // スマホ通知の宛先（Web Push）。通知を送るプログラムが読むため、読みは公開。書けるのは本人だけ。
    // 中身は「通知の宛先」と「出した回のid」だけ（句・名前・メールは入らない）。宛先は、こちらの秘密鍵がないと送れない
    match /pushq/{uid} {
      allow read: if true;
      allow create, update: if mine(uid) && request.resource.data.keys().hasOnly(['sub', 'on', 'all', 'sids', 'at']);
      allow delete: if mine(uid);
    }
    // ストッ句・マイページ・お問い合わせの控え：本人だけ
    match /data/users/{uid}/{doc} {
      allow read, write: if mine(uid);
    }
    // お問い合わせ（運営者はコンソールで読む）
    function admin() { return signedIn() && request.auth.token.email == 'hattyam@gmail.com'; }
    match /inquiries/{uid} {
      allow read, write: if mine(uid) || admin();
    }
    // 談話室（みんなの待合室）：ログインした人なら、読める・書ける。消せるのは運営者だけ
    match /lounge/{id} {
      allow read, create, update: if signedIn();
      allow delete: if admin();
    }
    // 広場の統計（仲間の人数・今日来た人・句の数）：ログインした人なら読める
    // 広場だより：全員が読める。書くのは運営者だけ
    match /news/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /members/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid);
    }
    match /stats/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }
    // いまひらいている人の印
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid);
    }
  }
}
